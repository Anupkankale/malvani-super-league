# Organiser login for the admin panel
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=change-me

# Encrypts the login cookie. Any random string of 32+ characters.
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# Turso database (leave unset locally to use .data/msl.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
